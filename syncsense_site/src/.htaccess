Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Live domain only: send syncsense.in to www.syncsense.in (the site's canonical address).
  # HTTPS itself is forced by Hostinger's "Force HTTPS" setting, which knows about its CDN.
  # Preview/temporary domains are left alone so the site can be tested before switching.
  RewriteCond %{HTTP_HOST} ^syncsense\.in$ [NC]
  RewriteRule ^ https://www.syncsense.in%{REQUEST_URI} [R=301,L]

  # /index.html -> /
  RewriteRule ^index\.html$ / [R=301,L]

  # Old page with no content on the previous site: send visitors to the demo dashboards.
  RewriteRule ^financial-analytics/?$ /manufacturing-from-factory-floor-to-pandl [R=301,L]

  # /about.html -> /about (one URL per page)
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [R=301,L]

  # Remove a trailing slash from page URLs: /about/ -> /about
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve /about from about.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|png|ico|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
