Options -Indexes
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: syncsense.in -> www.syncsense.in (live domain only; preview domains untouched).
  # HTTPS is forced by Hostinger's own "Force HTTPS" setting, which accounts for its CDN.
  RewriteCond %{HTTP_HOST} ^syncsense\.in$ [NC]
  RewriteRule ^ https://www.syncsense.in%{REQUEST_URI} [R=301,L]

  # Old Website Builder URLs -> new pages
# {{REDIRECTS}}

  RewriteRule ^index\.html$ / [R=301,L]

  # Folders are served with a trailing slash: /about -> /about/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(webp|png|ico|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml
</IfModule>
