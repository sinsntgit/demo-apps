{
  "name": "ovantaa-crm",
  "version": "1.19.0",
  "description": "Ovantaa CRM - enterprise CRM with campaign management. Node 22.5+; one runtime dependency (nodemailer).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "seed": "node --no-warnings server/seed.js --reset",
    "test": "node --no-warnings --test test/*.test.js",
    "e2e": "node --no-warnings test/e2e.mjs",
    "smtp-test": "node --no-warnings scripts/smtp-test.mjs",
    "backup": "node --no-warnings scripts/backup.mjs",
    "restore": "node --no-warnings scripts/restore.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "busboy": "^1.6.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "smtp-server": "^3.21.3"
  }
}
