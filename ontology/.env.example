# Signs sessions and encrypts stored AI-model API keys. If unset, one is generated in the data folder.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ONTO_SECRET_KEY=change-me
# First-run administrator (a password is generated and printed at first start if not set here)
ONTO_ADMIN_EMAIL=admin@yourcompany.com
# ONTO_ADMIN_PASSWORD=
# Set to 1 when served over HTTPS (marks cookies Secure, enables HSTS)
ONTO_COOKIE_SECURE=0
# Where the database lives. Default: the "data" folder next to the application.
# ONTO_DATA_DIR=D:\ontostudio\data
# ONTO_DATABASE_URL=postgresql+psycopg2://onto:password@db:5432/onto
# ONTO_APP_NAME=OntoStudio
