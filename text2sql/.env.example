# Required in production: signs sessions and encrypts stored DB passwords / API keys.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
T2S_SECRET_KEY=change-me
# First-run administrator (password must be changed at first sign-in if not set here)
T2S_ADMIN_EMAIL=admin@yourcompany.com
# T2S_ADMIN_PASSWORD=
# Set to 1 when served over HTTPS (marks cookies Secure, enables HSTS)
T2S_COOKIE_SECURE=1
# Metadata store. Default is SQLite in T2S_DATA_DIR; use Postgres for HA / multiple instances.
# T2S_DATABASE_URL=postgresql+psycopg2://t2s:password@db:5432/t2s
# T2S_DATA_DIR=/data
# T2S_APP_NAME=AskData
# Scheduled reports run inside the app process. With several instances, set this to 0 on all but one
# (schedules are also claimed atomically, so leaving it on everywhere is safe).
# T2S_SCHEDULER=1
